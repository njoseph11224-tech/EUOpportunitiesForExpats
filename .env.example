# Google Gemini API Key (Free tier via Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Credentials (Free tier PostgreSQL & Auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Admin Authentication Secret
ADMIN_PASSWORD=admin123

# Cron Secret Key for protecting /api/cron endpoints
CRON_SECRET=your_cron_secret_key_here
